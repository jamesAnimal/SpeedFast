        </children>
      </grid>
      <grid id="bcd17" binding="panelBotonPopRepartidor" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
