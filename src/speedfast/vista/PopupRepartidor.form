      </grid>
      <grid id="d51bd" binding="panelFormularioRepartidor" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-16053740"/>
        </properties>
        <border type="line">
          <color color="-1038182"/>
        </border>
        <children>
          <component id="38216" class="javax.swing.JLabel" binding="lblNombreRepartidor">
