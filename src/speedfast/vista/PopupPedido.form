              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Courier New" size="16"/>
              <foreground color="-14490369"/>
              <text value="Direccion:"/>
            </properties>
          </component>
          <component id="2f22e" class="javax.swing.JTextField" binding="txtfDireccionPedido">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <background color="-16053740"/>
              <font name="Courier New" size="16" style="0"/>
              <foreground color="-14490369"/>
              <selectedTextColor color="-16053740"/>
              <selectionColor color="-1038182"/>
            </properties>
          </component>
          <component id="54d51" class="javax.swing.JLabel" binding="lblTipoPedido">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Courier New" size="16"/>
              <foreground color="-14490369"/>
