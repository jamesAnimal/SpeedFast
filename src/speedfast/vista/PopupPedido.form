            </properties>
          </component>
          <component id="c65c4" class="javax.swing.JComboBox" binding="cmbxTipoPedido">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-16053740"/>
              <focusCycleRoot value="false"/>
              <font name="Courier New" size="16" style="0"/>
              <foreground color="-14490369"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="d4410" binding="panelTituloPopPedido" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
